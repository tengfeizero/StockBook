# 复制为 .env 后按需修改（Docker Compose 会自动读取）
# 注意：非 Docker 部署时程序不读取 .env，请用系统环境变量或启动脚本设置。

# 监听端口
HUOBEN_PORT=8080

# SQLite 数据库路径（相对路径以进程工作目录为基准）
HUOBEN_DB_PATH=data/huoben.db

# JWT 签名密钥。留空则自动生成到数据库同目录的 .jwt_secret（0600）。
# 多实例部署必须显式设置同一个值，否则各实例签发的令牌互不认。
# HUOBEN_JWT_SECRET=

# 信任的反向代理地址（逗号分隔 IP/CIDR），none 表示不信任任何代理。
# Caddy/Nginx 与应用同机时保持默认即可。
HUOBEN_TRUSTED_PROXIES=127.0.0.1,::1

# Windows 服务模式下程序所在目录（一般不用设置）
# HUOBEN_HOME=C:\huoben
